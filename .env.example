# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # JWT signing secret (generate a strong random string)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:port/db?sslmode=require)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_EMAIL=              # Email address that gets role "admin" on first registration
